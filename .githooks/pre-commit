#!/bin/bash
# Pre-commit hook: block secrets and infra references.
#
# Install: git config core.hooksPath .githooks
#
# Patterns live in .githooks/secret-patterns.local (gitignored, copy from
# .githooks/secret-patterns.example to bootstrap). The actual patterns are
# themselves operational fingerprints, so they aren't checked in.

PATTERNS_FILE=".githooks/secret-patterns.local"

# Always block real-secret prefixes — these are universal, not env-specific.
BUILTIN_PATTERNS=(
  'sk-proj-'
  'sk-SiusJ'
  'rl_7Hz'
  'ops_eyJ'
  'ghp_[A-Za-z0-9]{20,}'
)

# Load environment-specific patterns if the file exists.
LOCAL_PATTERNS=()
if [ -f "$PATTERNS_FILE" ]; then
  while IFS= read -r line; do
    # Skip blank lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    LOCAL_PATTERNS+=("$line")
  done < "$PATTERNS_FILE"
fi

PATTERNS=("${BUILTIN_PATTERNS[@]}" "${LOCAL_PATTERNS[@]}")

# Files exempt from checking
SKIP_FILES="\.githooks/(pre-commit|secret-patterns)"

ERRORS=0

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

for file in $STAGED_FILES; do
  if echo "$file" | grep -qE "$SKIP_FILES"; then
    continue
  fi

  for pattern in "${PATTERNS[@]}"; do
    MATCHES=$(git diff --cached -U0 -- "$file" | grep "^\+" | grep -v "^+++" | grep -iE "$pattern")
    if [ -n "$MATCHES" ]; then
      echo "BLOCKED in $file: pattern '$pattern'"
      echo "$MATCHES" | head -3
      echo ""
      ERRORS=$((ERRORS + 1))
    fi
  done
done

if [ $ERRORS -gt 0 ]; then
  echo "Commit blocked: $ERRORS sensitive pattern(s) detected."
  echo "Use env vars / 1Password refs instead of hardcoded values."
  echo "Edit $PATTERNS_FILE to adjust environment-specific patterns."
  echo "To bypass (emergency): git commit --no-verify"
  exit 1
fi
